# Install a version the moment it is published: the plugin's own releases are
# consumed by DSH immediately after `npm publish`, and pnpm/npm's fresh-release
# hold would otherwise substitute an older version silently.
minimumReleaseAge=0

# This package declares DSH and its own runtime as peer dependencies, which the
# consuming Harness provides. Installing them locally would pull the whole
# harness (600+ packages, ~500 MB) into this checkout and pin a stale DSH
# version into package-lock.json — the plugin's tests import only its own
# modules, so none of it is needed to build, test, or publish.
#
# `omit=peer` also keeps `npm ci` in CI at the same footprint as a plain
# checkout. Override locally with `npm install --include=peer` if you ever need
# to run the plugin against a locally resolved harness.
omit=peer
